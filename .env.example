# Copiá este archivo como .env y completá los valores
# NUNCA subas .env a GitHub

# Flask
FLASK_SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
FLASK_ENV=production

# Base de datos (Neon PostgreSQL)
DATABASE_URL=postgresql://usuario:contraseña@host/zynnos_central

# Usuario admin del panel (se crea al iniciar por primera vez)
ADMIN_EMAIL=tu@email.com
ADMIN_PASSWORD=contraseña_fuerte_minimo_16_caracteres

# Gmail SMTP para avisos
MAIL_USERNAME=zynnos.labs@gmail.com
MAIL_PASSWORD=contraseña_de_aplicacion_de_gmail

# Token secreto para el endpoint de cron-job.org
CRON_TOKEN=otro_token_largo_y_aleatorio

# URL pública de este panel (sin barra al final)
BASE_URL=https://tu-central.onrender.com
